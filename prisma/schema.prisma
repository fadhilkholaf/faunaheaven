generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum JournalCategory {
  WILDLIFE
  CONSERVATION
  CLIMATE
  COMMUNITY
}

enum CoinTransactionType {
  COURSE_REWARD
  QUIZ_REWARD
  DAILY_REWARD
  GACHA_SPIN
  DUPLICATE_CONVERSION
  MISSION_REWARD
  PROMO_REWARD
  ADJUSTMENT
}

enum PrizeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum MissionType {
  COURSE_MODULE
  QUIZ_COMPLETE
  GACHA_SPIN
  COLLECTION_ADD
}

enum CollectionTransactionType {
  WON
  GIFT_SENT
  GIFT_RECEIVED
  CONVERTED
}

model User {
  id String @id
  name String
  email String
  emailVerified Boolean @default(false)
  image String?
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  profile UserProfile?
  wallet Wallet?
  enrollments CourseEnrollment[]
  progress CourseProgress[]
  rewards CourseReward[]
  transactions CoinTransaction[]
  quizAttempts QuizAttempt[]
  gachaDraws GachaDraw[]
  collections UserCollection[]
  collectionTransactions CollectionTransaction[]
  missionProgress UserMissionProgress[]
  promoRedemptions PromoRedemption[]
  auditLogs AdminAuditLog[]
  @@unique([email])
  @@map("user")
}

model Session {
  id String @id
  expiresAt DateTime
  token String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("account")
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

model UserProfile {
  id String @id @default(cuid())
  userId String @unique
  displayName String
  bio String @default("")
  avatarUrl String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id String @id @default(cuid())
  userId String @unique
  coins Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoinTransaction {
  id String @id @default(cuid())
  userId String
  amount Int
  type CoinTransactionType
  referenceId String
  description String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
}

model CourseCategory {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  courses Course[]
  createdAt DateTime @default(now())
}

model Course {
  id String @id @default(cuid())
  categoryId String
  slug String @unique
  provider String
  title String
  description String
  imageUrl String
  rating Float @default(5)
  level CourseLevel @default(BEGINNER)
  durationMin Int
  rewardCoins Int @default(100)
  category CourseCategory @relation(fields: [categoryId], references: [id])
  modules CourseModule[]
  enrollments CourseEnrollment[]
  progress CourseProgress[]
  rewards CourseReward[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId])
}

model CourseModule {
  id String @id @default(cuid())
  courseId String
  position Int
  title String
  summary String
  content String
  durationMin Int @default(10)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress CourseProgress[]
  createdAt DateTime @default(now())
  @@unique([courseId, position])
  @@index([courseId])
}

model CourseEnrollment {
  id String @id @default(cuid())
  userId String
  courseId String
  enrolledAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@index([userId, enrolledAt])
}

model CourseProgress {
  id String @id @default(cuid())
  userId String
  courseId String
  moduleId String
  completedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId, moduleId])
  @@index([userId, courseId])
}

model CourseReward {
  id String @id @default(cuid())
  userId String
  courseId String
  coins Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())
  @@unique([userId, courseId])
}

model Journal {
  id String @id @default(cuid())
  slug String @unique
  title String
  excerpt String
  content String
  imageUrl String
  category JournalCategory
  readingMin Int @default(3)
  questions QuizQuestion[]
  attempts QuizAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category, createdAt])
}

model QuizQuestion {
  id String @id @default(cuid())
  journalId String
  position Int
  question String
  options Json
  answerIndex Int
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@unique([journalId, position])
}

model QuizAttempt {
  id String @id @default(cuid())
  userId String
  journalId String
  attemptKey String @unique
  score Int
  total Int
  rewardCoins Int
  answers Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, journalId])
}

model FAQ {
  id String @id @default(cuid())
  category String
  question String
  answer String
  position Int @default(0)
  createdAt DateTime @default(now())
  @@index([category, position])
}

model GachaBanner {
  id String @id @default(cuid())
  category String
  slug String @unique
  title String
  description String
  imageUrl String
  spinCost Int
  tenSpinCost Int
  active Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  prizes GachaPrize[]
  draws GachaDraw[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category, active])
}

model GachaPrize {
  id String @id @default(cuid())
  bannerId String
  faunaEntryId String
  rarity PrizeRarity
  stock Int
  initialStock Int
  weight Int @default(1)
  banner GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  faunaEntry FaunaEntry @relation(fields: [faunaEntryId], references: [id])
  draws GachaDraw[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([bannerId, stock])
  @@unique([bannerId, faunaEntryId])
}

model GachaDraw {
  id String @id @default(cuid())
  userId String
  bannerId String
  prizeId String
  requestKey String
  drawIndex Int
  quantity Int @default(1)
  cost Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner GachaBanner @relation(fields: [bannerId], references: [id])
  prize GachaPrize @relation(fields: [prizeId], references: [id])
  createdAt DateTime @default(now())
  @@unique([userId, requestKey, drawIndex])
  @@index([userId, createdAt])
}

model FaunaEntry {
  id String @id @default(cuid())
  slug String @unique
  name String
  scientificName String
  description String
  imageUrl String
  habitat String
  rarity PrizeRarity
  prizes GachaPrize[]
  collections UserCollection[]
  giftTransactions CollectionTransaction[]
  createdAt DateTime @default(now())
  @@index([rarity, createdAt])
}

model UserCollection {
  id String @id @default(cuid())
  userId String
  faunaEntryId String
  quantity Int @default(0)
  firstCollectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  faunaEntry FaunaEntry @relation(fields: [faunaEntryId], references: [id], onDelete: Cascade)
  @@unique([userId, faunaEntryId])
  @@index([userId, updatedAt])
}

model CollectionTransaction {
  id String @id @default(cuid())
  userId String
  faunaEntryId String
  type CollectionTransactionType
  quantity Int @default(1)
  targetUserId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  faunaEntry FaunaEntry @relation(fields: [faunaEntryId], references: [id])
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model DailyMission {
  id String @id @default(cuid())
  title String
  description String
  type MissionType
  target Int
  rewardCoins Int
  active Boolean @default(true)
  progress UserMissionProgress[]
  createdAt DateTime @default(now())
}

model UserMissionProgress {
  id String @id @default(cuid())
  userId String
  missionId String
  missionDate DateTime @db.Date
  progress Int @default(0)
  claimedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  @@unique([userId, missionId, missionDate])
  @@index([userId, missionDate])
}

model PromoCode {
  id String @id @default(cuid())
  code String @unique
  rewardCoins Int
  maxRedemptions Int?
  redemptionCount Int @default(0)
  active Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
  redemptions PromoRedemption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoRedemption {
  id String @id @default(cuid())
  userId String
  promoCodeId String
  rewardCoins Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  redeemedAt DateTime @default(now())
  @@unique([userId, promoCodeId])
}

model AdminAuditLog {
  id String @id @default(cuid())
  userId String
  action String
  entity String
  entityId String
  details Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
}
